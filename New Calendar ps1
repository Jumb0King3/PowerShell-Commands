# Manage-CalendarAccess.ps1
# Connects to Exchange Online if not already connected, then lets you
# Grant, View (all or one user), Edit, or Remove Calendar folder permissions -
# including any sub-calendars, not just the main Calendar folder - looping
# back to the menu after each action so you can perform multiple actions on
# the same connection.
# You can locate the calendar either by entering the mailbox owner's email,
# or by searching for the calendar by name across all mailboxes (useful for
# room/resource mailboxes where you don't know which mailbox owns it).
# Logs all output to a transcript file for ticket documentation.
# Pressing Enter with no input at any prompt cancels.

$logFolder = Join-Path $env:USERPROFILE "Documents\Scripts Logs"
if (-not (Test-Path $logFolder)) { New-Item -Path $logFolder -ItemType Directory -Force | Out-Null }
$logFile = Join-Path $logFolder "Manage-CalendarAccess_$(Get-Date -Format 'yyyy-MM-dd_HHmmss').txt"
Start-Transcript -Path $logFile | Out-Null

function Stop-ScriptHere {
    try {
        Disconnect-ExchangeOnline -Confirm:$false -ErrorAction SilentlyContinue | Out-Null
        Write-Host "`nDisconnected from Exchange Online." -ForegroundColor Cyan
    }
    catch { }
    Write-Host "Log saved to: $logFile" -ForegroundColor Cyan
    Stop-Transcript | Out-Null
    Read-Host "`nPress Enter to close this window"
}

# --- Ensure connected to Exchange Online ---
$connected = $false
try {
    Get-ConnectionInformation -ErrorAction Stop | Where-Object { $_.State -eq "Connected" } | ForEach-Object { $connected = $true }
}
catch { $connected = $false }

if (-not $connected) {
    if (-not (Get-Module -ListAvailable -Name ExchangeOnlineManagement)) {
        Write-Host "ExchangeOnlineManagement module not found. Installing..." -ForegroundColor Cyan
        try {
            Install-Module -Name ExchangeOnlineManagement -Scope CurrentUser -Force -ErrorAction Stop
        }
        catch {
            Write-Host "Error installing module: $($_.Exception.Message)" -ForegroundColor Red
            Stop-Transcript | Out-Null
            Read-Host "`nPress Enter to close this window"
            return
        }
    }

    try {
        Connect-ExchangeOnline -ErrorAction Stop
    }
    catch {
        try {
            Connect-ExchangeOnline -DisableWAM -ErrorAction Stop
        }
        catch {
            Write-Host "Error connecting to Exchange Online: $($_.Exception.Message)" -ForegroundColor Red
            Stop-Transcript | Out-Null
            Read-Host "`nPress Enter to close this window"
            return
        }
    }
    Write-Host "Connected to Exchange Online." -ForegroundColor Green
}

# --- Function: list Calendar folders (main + sub-calendars) for a known owner and let the user pick one ---
function Select-CalendarFolder {
    param($owner)

    try {
        $calendarFolders = Get-MailboxFolder -Identity "$($owner):\" -Recurse -ErrorAction Stop |
            Where-Object { $_.FolderClass -eq "IPF.Appointment" }
    }
    catch {
        Write-Host "Error: Could not list Calendar folders for $owner. $($_.Exception.Message)" -ForegroundColor Red
        return $null
    }

    if (-not $calendarFolders) {
        Write-Host "No Calendar folders found for $owner." -ForegroundColor Yellow
        return $null
    }

    Write-Host "`nCalendar folders found for $owner :" -ForegroundColor Cyan
    $i = 1
    $indexed = @{}
    foreach ($folder in $calendarFolders) {
        $displayName = ($folder.FolderPath -replace '/', '\').TrimStart('\')
        Write-Host "  $i. $displayName"
        $indexed[$i] = $folder
        $i++
    }

    if ($calendarFolders.Count -eq 1) {
        Write-Host "(Only one Calendar folder found - selecting it automatically.)" -ForegroundColor DarkGray
        $chosen = $indexed[1]
    }
    else {
        $selection = Read-Host "`nEnter the number of the Calendar folder to use (press Enter with no input to skip)"
        if ([string]::IsNullOrWhiteSpace($selection) -or -not $indexed.ContainsKey([int]$selection)) {
            Write-Host "No valid selection made. Skipping." -ForegroundColor Yellow
            return $null
        }
        $chosen = $indexed[[int]$selection]
    }

    return $chosen.Identity.ToString()
}

# --- Function: search for a calendar by name across every mailbox in the tenant ---
function Find-CalendarByName {
    param($searchText)

    try {
        $allMailboxes = Get-Mailbox -ResultSize Unlimited -ErrorAction Stop
    }
    catch {
        Write-Host "Error: Could not retrieve mailbox list. $($_.Exception.Message)" -ForegroundColor Red
        return $null
    }

    $matches = @()
    $total = $allMailboxes.Count
    $count = 0

    foreach ($mbx in $allMailboxes) {
        $count++
        Write-Progress -Activity "Searching calendars" -Status "$count of $total : $($mbx.DisplayName)" -PercentComplete (($count / $total) * 100)
        try {
            $calStats = Get-MailboxFolderStatistics -Identity $mbx.Identity -FolderScope Calendar -ErrorAction SilentlyContinue |
                Where-Object { $_.Name -like "*$searchText*" }
            foreach ($stat in $calStats) {
                $matches += [PSCustomObject]@{
                    Owner      = $mbx.PrimarySmtpAddress
                    Name       = $stat.Name
                    FolderPath = $stat.FolderPath
                }
            }
        }
        catch { }
    }
    Write-Progress -Activity "Searching calendars" -Completed

    if ($matches.Count -eq 0) {
        Write-Host "`nNo calendars matching '$searchText' were found." -ForegroundColor Yellow
        return $null
    }

    Write-Host "`nCalendars matching '$searchText' :" -ForegroundColor Cyan
    $i = 1
    $indexed = @{}
    foreach ($m in $matches) {
        $displayPath = ($m.FolderPath -replace '/', '\').TrimStart('\')
        Write-Host "  $i. $($m.Name)  -  $($m.Owner)  ($displayPath)"
        $indexed[$i] = $m
        $i++
    }

    $selection = Read-Host "`nEnter the number of the calendar to use (press Enter with no input to skip)"
    if ([string]::IsNullOrWhiteSpace($selection) -or -not $indexed.ContainsKey([int]$selection)) {
        Write-Host "No valid selection made. Skipping." -ForegroundColor Yellow
        return $null
    }
    $chosen = $indexed[[int]$selection]

    # Re-resolve the folder via Get-MailboxFolder to get its real Identity, rather than
    # constructing "Owner:\FolderPath" by hand - Exchange doesn't reliably accept a
    # hand-built identity for folder names containing spaces.
    #
    # NOTE: Get-MailboxFolderStatistics -FolderScope Calendar reports FolderPath RELATIVE
    # TO THE CALENDAR FOLDER, not the mailbox root - e.g. a sub-calendar physically at
    # "Calendar\Room Geordie" is reported as just "/Room Geordie". That makes FolderPath
    # from this cmdlet useless for rebuilding a real identity, so match on Name instead
    # (which both cmdlets report the same way), scoped to actual calendar folders via
    # FolderClass so a same-named non-calendar folder elsewhere in the mailbox can't match.
    try {
        $ownerFolders = Get-MailboxFolder -Identity "$($chosen.Owner):\" -Recurse -ErrorAction Stop
        $candidates = $ownerFolders | Where-Object { $_.Name -eq $chosen.Name -and $_.FolderClass -eq "IPF.Appointment" }

        if (-not $candidates) {
            Write-Host "Error: Could not re-resolve the selected calendar's identity." -ForegroundColor Red
            return $null
        }
        if (@($candidates).Count -gt 1) {
            Write-Host "Warning: Multiple calendars named '$($chosen.Name)' found for $($chosen.Owner) - using the first match." -ForegroundColor Yellow
        }
        $resolved = $candidates | Select-Object -First 1
        return $resolved.Identity.ToString()
    }
    catch {
        Write-Host "Error: Could not resolve the selected calendar's identity. $($_.Exception.Message)" -ForegroundColor Red
        return $null
    }
}

# --- Function: list Room Mailboxes and let the user pick one ---
# Room mailboxes use a plain, un-nested "Calendar" folder, so unlike a person's mailbox
# (which can have sub-calendars) there's no need to browse or resolve anything - the
# identity is always simply "mailbox:\Calendar".
function Select-RoomMailbox {
    try {
        $roomMailboxes = Get-Mailbox -RecipientTypeDetails RoomMailbox -ResultSize Unlimited -ErrorAction Stop | Sort-Object DisplayName
    }
    catch {
        Write-Host "Error: Could not retrieve room mailboxes. $($_.Exception.Message)" -ForegroundColor Red
        return $null
    }

    if (-not $roomMailboxes) {
        Write-Host "No room mailboxes found." -ForegroundColor Yellow
        return $null
    }

    Write-Host "`nRoom mailboxes :" -ForegroundColor Cyan
    $i = 1
    $indexed = @{}
    foreach ($room in $roomMailboxes) {
        Write-Host "  $i. $($room.DisplayName)  -  $($room.PrimarySmtpAddress)"
        $indexed[$i] = $room
        $i++
    }

    $selection = Read-Host "`nEnter the number of the room to use (press Enter with no input to skip)"
    if ([string]::IsNullOrWhiteSpace($selection) -or -not $indexed.ContainsKey([int]$selection)) {
        Write-Host "No valid selection made. Skipping." -ForegroundColor Yellow
        return $null
    }
    $chosen = $indexed[[int]$selection]

    return "$($chosen.PrimarySmtpAddress):\Calendar"
}

# --- Main menu loop ---
$keepGoing = $true

while ($keepGoing) {

    Write-Host "`nWhat do you want to do?" -ForegroundColor Cyan
    Write-Host "  1. Grant access (new permission)"
    Write-Host "  2. View all permissions on the calendar"
    Write-Host "  3. View one user's permission"
    Write-Host "  4. Edit existing permission (change access level)"
    Write-Host "  5. Remove permission"
    $action = Read-Host "`nEnter 1, 2, 3, 4, or 5 (press Enter with no input to exit)"
    if ([string]::IsNullOrWhiteSpace($action)) {
        Write-Host "No option entered. Exiting." -ForegroundColor Yellow
        break
    }

    Write-Host "`nHow do you want to locate the calendar?" -ForegroundColor Cyan
    Write-Host "  1. Enter the mailbox owner's email"
    Write-Host "  2. Search by calendar name across all mailboxes (e.g. a room/resource calendar)"
    Write-Host "  3. Select a Room Mailbox (list of room mailboxes and their main Calendar)"
    $lookupMethod = Read-Host "`nEnter 1, 2, or 3 (press Enter with no input to exit)"
    if ([string]::IsNullOrWhiteSpace($lookupMethod)) {
        Write-Host "No option entered. Exiting." -ForegroundColor Yellow
        break
    }

    $calendarIdentity = $null
    if ($lookupMethod -eq "1") {
        $owner = Read-Host "Enter the mailbox owner's email (whose calendars you want to check) (press Enter with no input to exit)"
        if ([string]::IsNullOrWhiteSpace($owner)) {
            Write-Host "No mailbox owner entered. Exiting." -ForegroundColor Yellow
            break
        }
        $calendarIdentity = Select-CalendarFolder -owner $owner
    }
    elseif ($lookupMethod -eq "2") {
        $searchText = Read-Host "Enter the calendar name (or part of it) to search for (press Enter with no input to exit)"
        if ([string]::IsNullOrWhiteSpace($searchText)) {
            Write-Host "No search text entered. Exiting." -ForegroundColor Yellow
            break
        }
        Write-Host "`nSearching all mailboxes for calendars matching '$searchText' - this can take a while on larger tenants..." -ForegroundColor Cyan
        $calendarIdentity = Find-CalendarByName -searchText $searchText
    }
    elseif ($lookupMethod -eq "3") {
        $calendarIdentity = Select-RoomMailbox
    }
    else {
        Write-Host "Invalid option entered." -ForegroundColor Yellow
        continue
    }

    if (-not $calendarIdentity) {
        Write-Host ""
        $again = Read-Host "Press Enter to return to the menu, or type X to exit"
        if ($again -eq "X" -or $again -eq "x") { $keepGoing = $false }
        continue
    }

    switch ($action) {

        "1" {
            $grantee = Read-Host "Enter the email of the user being granted access (press Enter with no input to skip)"
            if (-not [string]::IsNullOrWhiteSpace($grantee)) {
                Write-Host "`nAccess level options: Owner, PublishingEditor, Editor, PublishingAuthor, Author, NonEditingAuthor, Reviewer, Contributor, AvailabilityOnly, LimitedDetails, None" -ForegroundColor Cyan
                $accessRight = Read-Host "Enter the access level to grant (press Enter with no input to skip)"
                if (-not [string]::IsNullOrWhiteSpace($accessRight)) {
                    try {
                        Add-MailboxFolderPermission -Identity $calendarIdentity -User $grantee -AccessRights $accessRight -ErrorAction Stop
                        Write-Host "$grantee granted '$accessRight' access to the calendar." -ForegroundColor Green
                    }
                    catch {
                        Write-Host "Error: Could not grant access. $($_.Exception.Message)" -ForegroundColor Red
                        Write-Host "(If this user already has a permission on this calendar, use option 4 - Edit - instead.)" -ForegroundColor Yellow
                    }
                } else { Write-Host "No access level entered. Skipping." -ForegroundColor Yellow }
            } else { Write-Host "No user entered. Skipping." -ForegroundColor Yellow }
        }

        "2" {
            try {
                Write-Host "`nAll permissions on the calendar :" -ForegroundColor Cyan
                Get-MailboxFolderPermission -Identity $calendarIdentity -ErrorAction Stop | Select-Object User, AccessRights | Format-Table -AutoSize
            }
            catch {
                Write-Host "Error: Could not retrieve permissions. $($_.Exception.Message)" -ForegroundColor Red
            }
        }

        "3" {
            $grantee = Read-Host "Enter the email of the user whose permission you want to view (press Enter with no input to skip)"
            if (-not [string]::IsNullOrWhiteSpace($grantee)) {
                try {
                    $perm = Get-MailboxFolderPermission -Identity $calendarIdentity -User $grantee -ErrorAction Stop
                    if ($perm) {
                        Write-Host "`n$grantee's permission on the calendar :" -ForegroundColor Cyan
                        $perm | Select-Object User, AccessRights | Format-Table -AutoSize
                    } else {
                        Write-Host "$grantee has no permission set on this calendar." -ForegroundColor Yellow
                    }
                }
                catch {
                    Write-Host "Error: Could not retrieve permission for $grantee. $($_.Exception.Message)" -ForegroundColor Red
                }
            } else { Write-Host "No user entered. Skipping." -ForegroundColor Yellow }
        }

        "4" {
            $grantee = Read-Host "Enter the email of the user whose access you want to change (press Enter with no input to skip)"
            if (-not [string]::IsNullOrWhiteSpace($grantee)) {
                Write-Host "`nAccess level options: Owner, PublishingEditor, Editor, PublishingAuthor, Author, NonEditingAuthor, Reviewer, Contributor, AvailabilityOnly, LimitedDetails, None" -ForegroundColor Cyan
                $accessRight = Read-Host "Enter the new access level (press Enter with no input to skip)"
                if (-not [string]::IsNullOrWhiteSpace($accessRight)) {
                    try {
                        Set-MailboxFolderPermission -Identity $calendarIdentity -User $grantee -AccessRights $accessRight -ErrorAction Stop
                        Write-Host "$grantee's access to the calendar updated to '$accessRight'." -ForegroundColor Green
                    }
                    catch {
                        Write-Host "Error: Could not update access. $($_.Exception.Message)" -ForegroundColor Red
                        Write-Host "(If this user doesn't have a permission on this calendar yet, use option 1 - Grant - instead.)" -ForegroundColor Yellow
                    }
                } else { Write-Host "No access level entered. Skipping." -ForegroundColor Yellow }
            } else { Write-Host "No user entered. Skipping." -ForegroundColor Yellow }
        }

        "5" {
            $grantee = Read-Host "Enter the email of the user whose access you want to remove (press Enter with no input to skip)"
            if (-not [string]::IsNullOrWhiteSpace($grantee)) {
                Write-Host "`nThis will remove $grantee's access to the calendar." -ForegroundColor Red
                $confirm = Read-Host "Type YES to confirm (anything else skips)"
                if ($confirm -eq "YES") {
                    try {
                        Remove-MailboxFolderPermission -Identity $calendarIdentity -User $grantee -Confirm:$false -ErrorAction Stop
                        Write-Host "$grantee's access to the calendar has been removed." -ForegroundColor Green
                    }
                    catch {
                        Write-Host "Error: Could not remove access. $($_.Exception.Message)" -ForegroundColor Red
                    }
                } else { Write-Host "Not confirmed. Skipping." -ForegroundColor Yellow }
            } else { Write-Host "No user entered. Skipping." -ForegroundColor Yellow }
        }

        default {
            Write-Host "Invalid option entered." -ForegroundColor Yellow
        }
    }

    Write-Host ""
    $again = Read-Host "Press Enter to return to the menu, or type X to exit"
    if ($again -eq "X" -or $again -eq "x") {
        $keepGoing = $false
    }
}

Stop-ScriptHere
